# Copy to .env and fill in. NEVER commit .env.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# With 0, /start only displays your chat ID. Set it here and restart to pair.
# No remote user can claim ownership simply by messaging an unpaired bot.
ALLOWED_CHAT_ID=0
# The setup helper creates .local-token for the Edge extension.
# Copy it into the extension's Options page; never put it in website code.
# Optional overrides:
# MODEL=qwen3-coder:30b
# VISION_MODEL=qwen3-vl:30b-a3b-instruct
# VISION_ENABLED=1
# BROWSER_MODE=edge
# EDGE_CODRIVE_PROFILE_DIR=C:\Users\you\AppData\Local\JerryAI\EdgeProfile
# SANDBOX_ROOT=C:\Users\you
# MOCK_FORM_ENABLED=0
