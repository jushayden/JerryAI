# ── Telegram (required for bot mode; CLI mode works without) ─────────────
# Create a bot with @BotFather, get your numeric ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# ── Ollama ────────────────────────────────────────────────────────────────
# Model must support native tool calling (qwen2.5, llama3.1, llama3.3, mistral-nemo)
OLLAMA_MODEL=qwen2.5
OLLAMA_HOST=http://localhost:11434
# Context window — 2048 default silently truncates tool schemas; keep >= 8192
OLLAMA_NUM_CTX=8192

# ── X / Twitter (free tier: posting only, no search) ─────────────────────
# developer.x.com → project → app → keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── YouTube Data API v3 (read-only) ──────────────────────────────────────
# console.cloud.google.com → enable YouTube Data API v3 → API key
YOUTUBE_API_KEY=

# ── Job applications (browser-use) ────────────────────────────────────────
# Set to 1 to fill applications without ever clicking submit or asking approval —
# useful for testing a new job site before doing it for real.
BROWSER_USE_DRY_RUN=0
# Cap on browser-use's own step count per application (a multi-step ATS wizard
# can take a while; each step also costs an Ollama call).
APPLY_TO_JOB_MAX_STEPS=40

# ── Tests ─────────────────────────────────────────────────────────────────
# Set to 1 to run live smoke tests against real APIs (tests/live/)
RUN_LIVE_TESTS=0
