# Copy to .env and fill in. NEVER commit .env.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Leave 0 to auto-capture: the first person to /start the bot becomes the owner.
ALLOWED_CHAT_ID=0
# Optional overrides:
# MODEL=qwen3-coder:30b
# VISION_MODEL=qwen3-vl:30b-a3b-instruct
# VISION_ENABLED=1
# BROWSER_MODE=edge
# EDGE_CODRIVE_PROFILE_DIR=C:\Users\you\AppData\Local\JerryAI\EdgeProfile
# SANDBOX_ROOT=C:\Users\you

# Optional — Reddit + YouTube read-only search (see SOCIAL_SETUP.md):
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=pocket-agent:v1 (by /u/your_username)
# YOUTUBE_API_KEY=

# Optional — browser-use web sub-agent (the web_agent tool; off by default):
# BROWSER_USE_ENABLED=1
# BROWSER_USE_MODEL=qwen3-coder:30b
# BROWSER_USE_MAX_STEPS=40
# BROWSER_USE_STEP_TIMEOUT=120

# Optional — voice notes (local Whisper):
# WHISPER_MODEL=base
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE=int8
